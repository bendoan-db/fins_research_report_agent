# Local development env. Copy to .env and fill in. Databricks Apps runtime
# injects auth + experiment vars at deploy time, so this file is local-only.

DATABRICKS_CONFIG_PROFILE=DEFAULT

# MLflow experiment that traces land in. Create one in the workspace, copy its
# id here. The deployed app gets this via the `experiment` resource binding in
# databricks.yml.
MLFLOW_EXPERIMENT_ID=

MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
